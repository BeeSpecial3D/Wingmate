<Application x:Class="Wingmate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Dark menus (same look as the Abyss.ps1 overlay), with submenu support -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Th.menuBg}" BorderBrush="{DynamicResource Th.menuBorder}" BorderThickness="1" CornerRadius="6" Padding="3">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,4,10,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Chk" Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource Th.menuCheck}" FontWeight="Bold"
                             VerticalAlignment="Center" Visibility="Hidden"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                  <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#x203A;" Margin="14,0,0,0" FontSize="14"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="None" HorizontalOffset="4">
                <Border Background="{DynamicResource Th.menuBg}" BorderBrush="{DynamicResource Th.menuBorder}" BorderThickness="1" CornerRadius="6" Padding="3">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.menuHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Th.menuDisabled}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkSep" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="6,3" Background="{DynamicResource Th.menuSep}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Launcher buttons -->
    <Style x:Key="BigButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Th.buttonBg}" BorderBrush="{DynamicResource Th.buttonBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Th.buttonHoverBorder}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.buttonHoverBg}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Th.onBorder}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.onBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Th.link}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{DynamicResource Th.buttonBg}" BorderBrush="{DynamicResource Th.buttonBorder}" BorderThickness="1" CornerRadius="4" Padding="9,2">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.buttonHoverBg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Th.pillOnBorder}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.pillOnBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Th.pillOnText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Confirm dialog buttons: Tag="primary" gold, Tag="danger" red -->
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Th.buttonBg}" BorderBrush="{DynamicResource Th.buttonBorder}" BorderThickness="1" CornerRadius="6" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="primary">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Th.primaryBorder}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.primaryBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Th.primaryText}"/>
              </Trigger>
              <Trigger Property="Tag" Value="danger">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE05252"/>
                <Setter TargetName="Bd" Property="Background" Value="#40CC2B2B"/>
                <Setter Property="Foreground" Value="{DynamicResource Th.error}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.buttonHoverBg}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="Tag" Value="danger"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#CCCC2B2B"/>
                <Setter Property="Foreground" Value="White"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="Tag" Value="primary"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.primaryHover}"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Bd" Property="Padding" Value="13,5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HomeButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Image Source="pack://application:,,,/Assets/home-icon.png" Width="14" Height="14" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.iconHoverBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- plain text "Menu" button on the alerts and checklist windows (opens the launcher); theme colours -->
    <Style x:Key="MenuTextButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Height="18" CornerRadius="4" Padding="6,0" BorderThickness="1"
                    Background="{DynamicResource Th.buttonBg}" BorderBrush="{DynamicResource Th.buttonBorder}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.buttonHoverBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Th.buttonHoverBorder}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- padlock: closed = window locked (click-through), open = unlocked. Tag "locked" switches the drawing. -->
    <Style x:Key="LockButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Canvas Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path x:Name="Shackle" Data="M 9.4,7 L 9.4,3.6 A 2.4,2.4 0 0 0 4.6,3.6 L 4.6,4.6" Stroke="{DynamicResource Th.iconStroke}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="Body" Data="M 3.6,7 L 10.4,7 A 0.8,0.8 0 0 1 11.2,7.8 L 11.2,12 A 0.8,0.8 0 0 1 10.4,12.8 L 3.6,12.8 A 0.8,0.8 0 0 1 2.8,12 L 2.8,7.8 A 0.8,0.8 0 0 1 3.6,7 Z"
                      Stroke="{DynamicResource Th.iconStroke}" StrokeThickness="1.3"/>
                <Ellipse x:Name="Hole" Canvas.Left="6.3" Canvas.Top="9.1" Width="1.4" Height="1.6" Fill="{DynamicResource Th.iconStroke}"/>
              </Canvas>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="locked">
                <Setter TargetName="Shackle" Property="Data" Value="M 4.6,7 L 4.6,4.8 A 2.4,2.4 0 0 1 9.4,4.8 L 9.4,7"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.iconHoverBg}"/>
                <Setter TargetName="Shackle" Property="Stroke" Value="{DynamicResource Th.iconHover}"/>
                <Setter TargetName="Body" Property="Stroke" Value="{DynamicResource Th.iconHover}"/>
                <Setter TargetName="Hole" Property="Fill" Value="{DynamicResource Th.iconHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GearButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Path x:Name="X" Data="M 9,3.2 L 9,5.2 M 9,12.8 L 9,14.8 M 3.2,9 L 5.2,9 M 12.8,9 L 14.8,9 M 4.9,4.9 L 6.3,6.3 M 11.7,11.7 L 13.1,13.1 M 13.1,4.9 L 11.7,6.3 M 6.3,11.7 L 4.9,13.1 M 11.8,9 A 2.8,2.8 0 1 1 6.2,9 A 2.8,2.8 0 1 1 11.8,9" Stroke="{DynamicResource Th.iconStroke}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.iconHoverBg}"/>
                <Setter TargetName="X" Property="Stroke" Value="{DynamicResource Th.iconHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Settings window controls -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Th.text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Border x:Name="Box" CornerRadius="3" BorderBrush="{DynamicResource Th.checkBoxOutline}" BorderThickness="1" Background="Transparent"/>
                <TextBlock x:Name="Tick" Text="&#x2714;" Foreground="{DynamicResource Th.check}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Th.focus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumbDark" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse x:Name="E" Width="12" Height="12" Fill="{DynamicResource Th.focus}" Stroke="{DynamicResource Th.thumbStroke}" StrokeThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="E" Property="Fill" Value="{DynamicResource Th.thumbHover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderPageDark" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkSlider" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="16">
              <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Th.sliderTrack}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderPageDark}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderPageDark}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumbDark}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwapButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Path x:Name="P" Data="M 5.5,4.5 L 10,9 L 5.5,13.5 M 12.5,4.5 L 12.5,13.5" Stroke="{DynamicResource Th.iconStroke}" StrokeThickness="1.3"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.iconHoverBg}"/>
                <Setter TargetName="P" Property="Stroke" Value="{DynamicResource Th.iconHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Th.iconStroke}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Path x:Name="X" Data="M 5,5 L 13,13 M 13,5 L 5,13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#CCCC2B2B"/>
                <Setter TargetName="X" Property="Stroke" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MinButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4" Background="Transparent">
              <Path x:Name="X" Data="M 5,9.5 L 13,9.5" Stroke="{DynamicResource Th.iconStroke}" StrokeThickness="1.4"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.iconHoverBg}"/>
                <Setter TargetName="X" Property="Stroke" Value="{DynamicResource Th.iconHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Th.scrollThumb}" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
