<Window x:Class="Wingmate.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wingmate" Width="340" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource Th.text}"
        FontFamily="Segoe UI" FontSize="12" Icon="Assets/wingmate.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="Panel" CornerRadius="10" Background="{DynamicResource Th.panelBg}" BorderBrush="{DynamicResource Th.panelBorder}" BorderThickness="1" Padding="12,8,12,10">
    <Border.ContextMenu>
      <ContextMenu x:Name="Menu"/>
    </Border.ContextMenu>
    <StackPanel>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/wingmate-icon.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Wingmate" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}"/>
          <TextBlock FontSize="10.5" Foreground="{DynamicResource Th.muted}">
            <TextBlock.Resources>
              <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Th.link}"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Resources>
            <Run Text="a companion for Aion 2 · by "/><Hyperlink Click="Project_Click" ToolTip="Wingmate on GitHub" Focusable="False">BeeSpecial3D</Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource GearButton}" ToolTip="Settings" Click="Gear_Click" Margin="0,0,2,0"/>
          <Button Style="{StaticResource MinButton}" ToolTip="Hide the launcher (Wingmate keeps running in the tray)" Click="Min_Click" Margin="0,0,2,0"/>
          <Button Style="{StaticResource CloseButton}" ToolTip="Quit Wingmate" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Region" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <StackPanel x:Name="RegionPanel" Orientation="Horizontal" Margin="0,0,0,10"/>

      <TextBlock Text="Character" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <DockPanel Margin="0,0,0,10">
        <Button x:Name="CharBtn" Style="{StaticResource BigButton}" Margin="0" Click="CharName_Click" ToolTip="Pick a character, add or remove one">
          <DockPanel>
            <TextBlock Text="&#x25BE;" DockPanel.Dock="Right" Foreground="{DynamicResource Th.muted}" Margin="6,0,0,0"/>
            <TextBlock x:Name="CharName" Text="Character name" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Button>
      </DockPanel>

      <TextBlock Text="Windows" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <Button x:Name="BtnAbyss" Style="{StaticResource BigButton}" Click="BtnAbyss_Click">
        <Grid>
          <StackPanel>
            <TextBlock Text="Abyss alerts"/>
            <TextBlock x:Name="AbyssSub" Text="Countdown overlay with voice warnings" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource Th.muted}"/>
          </StackPanel>
          <Border x:Name="AbyssBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="{DynamicResource Th.badgeBg}">
            <TextBlock x:Name="AbyssBadgeText" Text="OPEN" FontSize="9" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Button>
      <Button x:Name="BtnChecklist" Style="{StaticResource BigButton}" Click="BtnChecklist_Click">
        <Grid>
          <StackPanel>
            <TextBlock Text="Checklist"/>
            <TextBlock x:Name="ChecklistSub" Text="Dailies, weeklies and your own lists" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource Th.muted}"/>
          </StackPanel>
          <Border x:Name="ChecklistBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="{DynamicResource Th.badgeBg}">
            <TextBlock x:Name="ChecklistBadgeText" Text="CLOSED" FontSize="9" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Button>
      <Button x:Name="BtnBoth" Style="{StaticResource BigButton}" Click="BtnBoth_Click">
        <TextBlock x:Name="BothText" Text="Open both"/>
      </Button>
      <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Th.liveText}" Margin="0,0,0,6" Visibility="Collapsed"/>

      <CheckBox x:Name="AutoMinBox" Style="{StaticResource DarkCheck}" Content="Auto-minimize after opening" FontSize="11" Margin="0,2,0,2"
                ToolTip="Tuck the launcher into the tray after opening a window" Click="AutoMin_Click"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Th.faint}" FontSize="10.5" Margin="0,2,0,8"
                 Text="Drag to move"/>
      <Button x:Name="UpdateLink" Style="{StaticResource LinkButton}" Visibility="Collapsed" Content="Update ready · Restart"
              FontSize="10.5" HorizontalAlignment="Left" Margin="0,0,0,4" Click="Update_Click"/>
      <DockPanel>
        <Button Style="{StaticResource LinkButton}" Content="Support this app ❤️" Click="Support_Click" DockPanel.Dock="Left"/>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{DynamicResource Th.versionText}" FontSize="10"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
