<Window x:Class="Wingmate.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wingmate" Width="340" MinWidth="340" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource Th.text}"
        FontFamily="Segoe UI" FontSize="12" Icon="Assets/wingmate.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="Panel" CornerRadius="10" Background="{DynamicResource Th.panelBg}" BorderBrush="{DynamicResource Th.panelBorder}" BorderThickness="1" Padding="12,8,12,10">
    <Border.ContextMenu>
      <ContextMenu x:Name="Menu"/>
    </Border.ContextMenu>
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="Body">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/wingmate-icon.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Wingmate" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}"/>
          <TextBlock FontSize="10.5" Foreground="{DynamicResource Th.muted}">
            <TextBlock.Resources>
              <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Th.link}"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Resources>
            <Run Text="a companion for Aion 2 · by "/><Hyperlink Click="Project_Click" ToolTip="Wingmate on GitHub" Focusable="False">BeeSpecial3D</Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource GearButton}" ToolTip="Settings" Click="Gear_Click" Margin="0,0,2,0"/>
          <Button Style="{StaticResource MinButton}" ToolTip="Hide the launcher (Wingmate keeps running in the tray)" Click="Min_Click" Margin="0,0,2,0"/>
          <Button Style="{StaticResource CloseButton}" ToolTip="Quit Wingmate" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Region" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <StackPanel x:Name="RegionPanel" Orientation="Horizontal" Margin="0,0,0,10"/>

      <TextBlock Text="Character" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <!-- First run: name the character first (highlighted); only the Checklist waits for it -->
      <Border x:Name="NamePrompt" Visibility="Collapsed" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1.5" Padding="10,8"
              BorderBrush="{DynamicResource Th.pillOnBorder}" Background="{DynamicResource Th.pillOnBg}">
        <StackPanel>
          <TextBlock Text="First step: enter your character name" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Th.pillOnText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
          <DockPanel>
            <Button x:Name="NameSave" Style="{StaticResource DialogButton}" Tag="primary" Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0"
                    MinWidth="64" IsEnabled="False" Click="NameSave_Click" ToolTip="Save the name (Enter)"/>
            <Grid>
              <TextBox x:Name="NameBox" FontSize="12" MaxLength="40" Padding="5,4" VerticalContentAlignment="Center"
                       Foreground="{DynamicResource Th.text}" Background="{DynamicResource Th.inputBg}" BorderBrush="{DynamicResource Th.focus}"
                       BorderThickness="1" CaretBrush="{DynamicResource Th.caret}" KeyDown="NameBox_KeyDown" TextChanged="NameBox_TextChanged"/>
              <TextBlock x:Name="NameHint" Text="Enter your character name" FontSize="12" Foreground="{DynamicResource Th.faint}" IsHitTestVisible="False"
                         Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DockPanel>
          <Button x:Name="FirstClassBtn" Style="{StaticResource BigButton}" Margin="0,6,0,0" Click="FirstClass_Click"
                  ToolTip="Your class (optional). You can change it later next to your character name." AutomationProperties.Name="Class">
            <DockPanel>
              <TextBlock Text="&#x25BE;" DockPanel.Dock="Right" Foreground="{DynamicResource Th.muted}" Margin="6,0,0,0"/>
              <TextBlock x:Name="FirstClassText" Text="Class (optional)" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Button>
          <TextBlock Text="Your checklist unlocks once it's saved." FontSize="10.5" Foreground="{DynamicResource Th.muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <DockPanel x:Name="CharRow" Margin="0,0,0,10">
        <Button x:Name="ClassBtn" Style="{StaticResource BigButton}" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="104" Click="Class_Click"
                ToolTip="Your character's class (used by Guide)" AutomationProperties.Name="Class">
          <DockPanel>
            <TextBlock Text="&#x25BE;" DockPanel.Dock="Right" Foreground="{DynamicResource Th.muted}" Margin="6,0,0,0"/>
            <TextBlock x:Name="ClassText" Text="Class" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Button>
        <Button x:Name="CharBtn" Style="{StaticResource BigButton}" Margin="0" Click="CharName_Click" ToolTip="Pick a character, add or remove one">
          <DockPanel>
            <TextBlock Text="&#x25BE;" DockPanel.Dock="Right" Foreground="{DynamicResource Th.muted}" Margin="6,0,0,0"/>
            <TextBlock x:Name="CharName" Text="Character name" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Button>
      </DockPanel>

      <TextBlock Text="Windows" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Th.title}" Margin="0,0,0,4"/>
      <Button x:Name="BtnAbyss" Style="{StaticResource BigButton}" Click="BtnAbyss_Click">
        <Grid>
          <StackPanel>
            <TextBlock Text="Abyss alerts"/>
            <TextBlock x:Name="AbyssSub" Text="Countdown overlay with voice warnings" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource Th.muted}"/>
          </StackPanel>
          <Border x:Name="AbyssBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="{DynamicResource Th.badgeBg}">
            <TextBlock x:Name="AbyssBadgeText" Text="OPEN" FontSize="9" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Button>
      <Button x:Name="BtnChecklist" Style="{StaticResource BigButton}" Click="BtnChecklist_Click" ToolTipService.ShowOnDisabled="True">
        <Grid>
          <StackPanel>
            <TextBlock Text="Checklist"/>
            <TextBlock x:Name="ChecklistSub" Text="Dailies, weeklies, events and your own lists" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource Th.muted}"/>
          </StackPanel>
          <Border x:Name="ChecklistBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="{DynamicResource Th.badgeBg}">
            <TextBlock x:Name="ChecklistBadgeText" Text="CLOSED" FontSize="9" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Button>
      <Button x:Name="BtnGuide" Style="{StaticResource BigButton}" Click="BtnGuide_Click" AutomationProperties.Name="Class guide"
              ToolTip="Class guides by AION 2 Global Guides (aion2-guides.info). Opens your class page in your browser.">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Guide" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="GuideSub" Text="Class guide on aion2-guides.info" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource Th.muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="&#x2197;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Th.muted}"/>
        </Grid>
      </Button>
      <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Th.liveText}" Margin="0,0,0,6" Visibility="Collapsed"/>

      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Th.faint}" FontSize="10.5" Margin="0,4,0,8"
                 Text="Drag to move"/>
      <Button x:Name="UpdateLink" Style="{StaticResource LinkButton}" Visibility="Collapsed" Content="Update ready · Restart"
              FontSize="10.5" HorizontalAlignment="Left" Margin="0,0,0,4" Click="Update_Click"/>
      <DockPanel>
        <Button Style="{StaticResource LinkButton}" Content="Support this app ❤️" Click="Support_Click" DockPanel.Dock="Left"/>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{DynamicResource Th.versionText}" FontSize="10"/>
      </DockPanel>
    </StackPanel>
    <!-- Resize: right edge (width), bottom edge (height) and the corner grip (both), like the alerts and checklist windows -->
    <Thumb x:Name="EdgeRight" Grid.RowSpan="2" Width="6" HorizontalAlignment="Right" Margin="0,0,-12,0" Cursor="SizeWE" Focusable="False">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
    </Thumb>
    <Thumb x:Name="EdgeBottom" Grid.RowSpan="2" Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-10" Cursor="SizeNS" Focusable="False">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
    </Thumb>
    <Thumb x:Name="ResizeGrip" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Margin="0,0,-12,-10" Cursor="SizeNWSE" Focusable="False" ToolTip="Drag to change the size">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Path x:Name="GripPath" Data="M 12,3 L 3,12 M 12,7 L 7,12 M 12,11 L 11,12" Stroke="{DynamicResource Th.grip}" StrokeThickness="1.2"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GripPath" Property="Stroke" Value="{DynamicResource Th.gripHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
    </Grid>
  </Border>
</Window>
